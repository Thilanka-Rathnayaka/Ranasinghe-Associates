                form_submit: "செய்தி அனுப்பு",
                footer_about_title: "ரணசிங்க & இணையர்கள் பற்றி",
                footer_about_text: "இலங்கையில் தொழில்முறை உத்தரவாதம், கணக்கியல் மற்றும் வரி சேவைகளுக்கான உங்கள் நம்பகமான கூட்டாளர். 2009 முதல் சிறந்து விளங்குதல் மற்றும் வாடிக்கையாளர் வெற்றிக்கு அர்ப்பணிக்கப்பட்டது.",
