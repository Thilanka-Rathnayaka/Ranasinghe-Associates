    <!-- Services Section -->
    <section class="services" id="services">
        <div class="container">
            <div class="section-header">
                <h2 data-key="services_title">Our Services</h2>
                <p data-key="services_subtitle">Comprehensive financial solutions designed to meet your business needs and drive growth</p>
            </div>
            <div class="services-grid">
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-search-dollar"></i>
                    </div>
                    <h3 data-key="service1_title">Auditing</h3>
                    <p data-key="service1_desc">Comprehensive audit services including statutory audits, internal audits, and compliance reviews to ensure accuracy and transparency in your financial reporting.</p>
                </div>
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-calculator"></i>
                    </div>
                    <h3 data-key="service2_title">Tax Preparation</h3>
                    <p data-key="service2_desc">Expert tax planning and preparation services for individuals and businesses. We ensure compliance with Sri Lankan tax regulations while optimizing your tax position.</p>
                </div>
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-book"></i>
                    </div>
                    <h3 data-key="service3_title">Bookkeeping</h3>
                    <p data-key="service3_desc">Accurate and timely bookkeeping services to maintain your financial records. We handle day-to-day accounting so you can focus on growing your business.</p>
                </div>
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-chart-bar"></i>
                    </div>
                    <h3 data-key="service4_title">Financial Consulting</h3>
                    <p data-key="service4_desc">Strategic financial advisory services including business planning, financial analysis, risk management, and investment advisory to help you make informed decisions.</p>
                </div>
            </div>
        </div>
    </section>

