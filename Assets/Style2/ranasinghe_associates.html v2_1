let curLang='en', curTheme='dark';

/* ══ THEME ══ */
function toggleTheme(){
  curTheme = curTheme==='dark'?'light':'dark';
  document.documentElement.setAttribute('data-theme',curTheme);
  localStorage.setItem('ra_theme',curTheme);
}

/* ══ LANGUAGE ══ */
function toggleLang(){
  const t=document.getElementById('langTrig'), d=document.getElementById('langDd');
  t.classList.toggle('open'); d.classList.toggle('open');
}
function setLang(lang){
  curLang=lang;
  document.documentElement.setAttribute('data-lang',lang);
  localStorage.setItem('ra_lang',lang);
  document.getElementById('langLbl').textContent=lang.toUpperCase();
  document.querySelectorAll('.lang-opt').forEach(el=>el.classList.toggle('active',el.dataset.lv===lang));
  const t=T[lang];
  // Apply to all data-i18n elements
  document.querySelectorAll('[data-i18n]').forEach(el=>{
    const k=el.getAttribute('data-i18n');
    if(t[k]!==undefined) el.innerHTML=t[k];
  });
  // Placeholders
  document.querySelectorAll('[data-ph]').forEach(el=>{
    const k=el.getAttribute('data-ph');
    if(t[k]!==undefined) el.placeholder=t[k];
  });
  // Close
  document.getElementById('langTrig').classList.remove('open');
  document.getElementById('langDd').classList.remove('open');
}

/* ══ NAV SCROLL ══ */
window.addEventListener('scroll',()=>document.getElementById('mainNav').classList.toggle('scrolled',scrollY>50));

/* ══ MOBILE MENU ══ */
function toggleMenu(){
  const m=document.getElementById('mobMenu');
  m.style.display=m.style.display==='flex'?'none':'flex';
}

/* ══ CLOSE LANG DD ON OUTSIDE CLICK ══ */
document.addEventListener('click',e=>{
  if(!document.querySelector('.lang-sw').contains(e.target)){
    document.getElementById('langTrig').classList.remove('open');
    document.getElementById('langDd').classList.remove('open');
  }
});

/* ══ INTERSECTION OBSERVER ══ */
const io=new IntersectionObserver((es)=>es.forEach((e,i)=>{
  if(e.isIntersecting) setTimeout(()=>e.target.classList.add('vis'),i*90);
}),{threshold:.1});
document.querySelectorAll('.stat,.svc-card,.why-item').forEach(el=>io.observe(el));

/* ══ COUNTER ══ */
const co=new IntersectionObserver(es=>{
  es.forEach(e=>{
    if(!e.isIntersecting) return;
    e.target.querySelectorAll('[data-count]').forEach(el=>{
      const target=+el.dataset.count, suffix=target>=100?'+':(target===2?'':'+');
      let cur=0,step=target/40;
      const id=setInterval(()=>{
        cur=Math.min(cur+step,target);
        el.textContent=Math.floor(cur)+suffix;
        if(cur>=target)clearInterval(id);
      },40);
    });
    co.unobserve(e.target);
  });
},{threshold:.5});
const statsEl=document.getElementById('stats');
if(statsEl)co.observe(statsEl);

/* ══ FORM SUBMIT ══ */
function handleSubmit(e){
  const btn=e.target, t=T[curLang];
  btn.textContent=t.sent||'✓ Sent!';
  btn.style.cssText='background:#2a7a5e;color:#fff;';
  setTimeout(()=>{btn.textContent=t.f_send||'Send Message';btn.style.cssText='';},3500);
}

/* ══ RESTORE PREFERENCES ══ */
(function(){
  const th=localStorage.getItem('ra_theme');
  const la=localStorage.getItem('ra_lang');
  if(th && th!=='dark') toggleTheme();
  if(la && la!=='en') setLang(la);
})();
</script>
