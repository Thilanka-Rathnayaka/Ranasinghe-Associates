<!DOCTYPE html>
<html lang="en" data-theme="dark" data-lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ranasinghe & Associates | Assurance, Accounting & Tax Services</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600;700&family=Noto+Sans+Sinhala:wght@300;400;500;600;700&family=Noto+Sans+Tamil:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ══════════════════════════════════════
   DARK THEME (default)
══════════════════════════════════════ */
:root,[data-theme="dark"]{
  --bg:#0D1B2E; --bg-mid:#152238; --bg-light:#1E3150; --bg-card:#152238;
  --bg-input:rgba(13,27,46,0.88); --bg-footer:#080F1A;
  --nav-bg:rgba(13,27,46,0.97);
  --gold:#C9984A; --gold-lt:#E2B96F; --gold-pale:#F5E6C8;
  --gold-muted:rgba(201,152,74,0.55); --gold-faint:rgba(201,152,74,0.07);
  --text-h:#E2B96F; --text-b:#F5E6C8; --text-sub:rgba(245,230,200,0.55);
  --text-m:rgba(201,152,74,0.6);
  --border:rgba(201,152,74,0.15); --border-hov:rgba(201,152,74,0.45);
  --shadow:rgba(0,0,0,0.4); --shadow-btn:rgba(201,152,74,0.25);
  --circ:rgba(201,152,74,0.07); --hline:rgba(201,152,74,0.11);
  --glow:rgba(201,152,74,0.07); --noise:0.4;
  --stat-c:#C9984A; --svc-n:rgba(201,152,74,0.05);
}
/* ══════════════════════════════════════
   LIGHT THEME
══════════════════════════════════════ */
[data-theme="light"]{
  --bg:#F3EDE0; --bg-mid:#EAE2D2; --bg-light:#DDD4C0; --bg-card:#FFFFFF;
  --bg-input:rgba(255,255,255,0.92); --bg-footer:#E3D9C8;
  --nav-bg:rgba(243,237,224,0.97);
  --gold:#9B6A0A; --gold-lt:#B87D12; --gold-pale:#4A3008;
  --gold-muted:rgba(155,106,10,0.6); --gold-faint:rgba(155,106,10,0.07);
  --text-h:#7A4F08; --text-b:#1A2B42; --text-sub:rgba(26,43,66,0.58);
  --text-m:rgba(155,106,10,0.65);
  --border:rgba(155,106,10,0.18); --border-hov:rgba(155,106,10,0.5);
  --shadow:rgba(26,43,66,0.1); --shadow-btn:rgba(155,106,10,0.18);
  --circ:rgba(155,106,10,0.06); --hline:rgba(155,106,10,0.09);
  --glow:rgba(155,106,10,0.05); --noise:0.12;
  --stat-c:#9B6A0A; --svc-n:rgba(155,106,10,0.05);
}
/* ══════════════════════════════════════
   LANG FONTS
══════════════════════════════════════ */
[data-lang="si"] .lt{font-family:'Noto Sans Sinhala',sans-serif;}
[data-lang="ta"] .lt{font-family:'Noto Sans Tamil',sans-serif;}

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{
  background:var(--bg);color:var(--text-b);
  font-family:'Montserrat',sans-serif;overflow-x:hidden;
  transition:background .4s,color .4s;
}
body::before{
  content:'';position:fixed;inset:0;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.05'/%3E%3C/svg%3E");
  pointer-events:none;z-index:0;opacity:var(--noise);transition:opacity .4s;
}

/* ══ NAV ══ */
nav{
  position:fixed;top:0;left:0;right:0;z-index:1000;
  padding:18px 52px;display:flex;align-items:center;justify-content:space-between;gap:16px;
  transition:all .4s;
}
nav.scrolled{
  background:var(--nav-bg);backdrop-filter:blur(22px);
  border-bottom:1px solid var(--border);padding:12px 52px;
  box-shadow:0 4px 40px var(--shadow);
}
.nav-logo{display:flex;align-items:center;gap:12px;text-decoration:none;flex-shrink:0;}
.nav-logo-mark{
  width:40px;height:40px;border:2px solid var(--gold);
  display:flex;align-items:center;justify-content:center;
  font-family:'Cormorant Garamond',serif;font-size:20px;font-weight:600;color:var(--gold);
  transition:all .4s;
}
.nav-logo-text{
  font-family:'Cormorant Garamond',serif;font-size:15px;font-weight:600;
  color:var(--gold);letter-spacing:2.5px;text-transform:uppercase;line-height:1.2;
  transition:color .4s;
}
.nav-logo-text span{
  display:block;font-size:9px;font-family:'Montserrat',sans-serif;
  font-weight:400;letter-spacing:3px;color:var(--text-m);transition:color .4s;
}
.nav-links{display:flex;gap:30px;list-style:none;}
.nav-links a{
  font-size:10.5px;font-weight:500;letter-spacing:2.5px;text-transform:uppercase;
  color:var(--text-b);text-decoration:none;opacity:.75;transition:opacity .3s,color .3s;
  position:relative;
}
.nav-links a::after{content:'';position:absolute;bottom:-4px;left:0;width:0;height:1px;background:var(--gold);transition:width .3s;}
.nav-links a:hover{opacity:1;color:var(--gold);}
.nav-links a:hover::after{width:100%;}

/* ── Nav Right Controls ── */
.nav-right{display:flex;align-items:center;gap:8px;}

.nav-cta{
  padding:9px 22px;border:1px solid var(--gold);color:var(--gold);
  font-size:9.5px;font-weight:600;letter-spacing:2px;text-transform:uppercase;
  text-decoration:none;transition:all .3s;white-space:nowrap;
}
.nav-cta:hover{background:var(--gold);color:var(--bg);}

/* Theme Toggle */
.theme-btn{
  width:38px;height:38px;border:1px solid var(--border);background:var(--gold-faint);
  display:flex;align-items:center;justify-content:center;cursor:pointer;
  transition:all .3s;color:var(--gold);flex-shrink:0;position:relative;
}
.theme-btn:hover{border-color:var(--gold);background:rgba(201,152,74,0.12);}
.theme-btn .i-sun,.theme-btn .i-moon{position:absolute;transition:opacity .3s,transform .4s;}
[data-theme="dark"] .i-sun{opacity:1;transform:rotate(0) scale(1);}
[data-theme="dark"] .i-moon{opacity:0;transform:rotate(80deg) scale(.5);}
[data-theme="light"] .i-sun{opacity:0;transform:rotate(-80deg) scale(.5);}
[data-theme="light"] .i-moon{opacity:1;transform:rotate(0) scale(1);}

/* Lang Switcher */
.lang-sw{position:relative;}
.lang-trigger{
  display:flex;align-items:center;gap:7px;padding:8px 12px;
  border:1px solid var(--border);background:var(--gold-faint);cursor:pointer;
  color:var(--gold);font-size:10px;font-weight:600;letter-spacing:1.5px;
  text-transform:uppercase;transition:all .3s;white-space:nowrap;
}
.lang-trigger:hover{border-color:var(--gold);background:rgba(201,152,74,0.12);}
.lang-trigger .chev{transition:transform .3s;}
.lang-trigger.open .chev{transform:rotate(180deg);}

.lang-dd{
  position:absolute;top:calc(100% + 8px);right:0;
  background:var(--nav-bg);backdrop-filter:blur(20px);
  border:1px solid var(--border);box-shadow:0 14px 44px var(--shadow);
  min-width:175px;z-index:500;
  opacity:0;pointer-events:none;transform:translateY(-6px);
  transition:all .25s;
}
.lang-dd.open{opacity:1;pointer-events:all;transform:translateY(0);}
.lang-opt{
  display:flex;align-items:center;gap:11px;padding:12px 16px;
  cursor:pointer;transition:background .2s;
  border-bottom:1px solid var(--border);
}
.lang-opt:last-child{border-bottom:none;}
.lang-opt:hover{background:var(--gold-faint);}
.lang-opt.active{background:rgba(201,152,74,0.1);}
.lang-opt-names{display:flex;flex-direction:column;gap:2px;flex:1;}
.lang-opt-code{font-size:9.5px;font-weight:700;letter-spacing:2px;color:var(--gold);text-transform:uppercase;}
.lang-opt-nat{font-size:12px;color:var(--text-sub);}
.lang-chk{color:var(--gold);opacity:0;flex-shrink:0;}
.lang-opt.active .lang-chk{opacity:1;}

.hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:4px;}
.hamburger span{display:block;width:22px;height:1.5px;background:var(--gold);transition:all .3s;}

/* ══ HERO ══ */
.hero{
  min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;
  text-align:center;position:relative;padding:100px 40px 60px;overflow:hidden;
}
.hero-bg{position:absolute;inset:0;z-index:0;overflow:hidden;}
.hero-bg-c{
  position:absolute;border-radius:50%;border:1px solid var(--circ);
  transition:border-color .4s;
}
.hero-bg-c:nth-child(1){width:600px;height:600px;top:50%;left:50%;transform:translate(-50%,-50%);}
.hero-bg-c:nth-child(2){width:900px;height:900px;top:50%;left:50%;transform:translate(-50%,-50%);}
.hero-bg-c:nth-child(3){width:1200px;height:1200px;top:50%;left:50%;transform:translate(-50%,-50%);}
.hero-bg-l{
  position:absolute;height:1px;width:100%;
  background:linear-gradient(90deg,transparent,var(--hline),transparent);
}
.hero-bg-l:nth-child(4){top:30%;}
.hero-bg-l:nth-child(5){top:70%;}
.hero-glow{
  position:absolute;width:500px;height:500px;
  background:radial-gradient(ellipse,var(--glow) 0%,transparent 70%);
  top:50%;left:50%;transform:translate(-50%,-50%);pointer-events:none;
}
.hero-content{position:relative;z-index:1;}
.hero-badge{
  display:inline-flex;align-items:center;gap:10px;
  padding:8px 20px;border:1px solid var(--border);
  font-size:10px;letter-spacing:3px;text-transform:uppercase;color:var(--gold);
  margin-bottom:48px;opacity:0;animation:fadeUp .8s ease .2s forwards;
  transition:border-color .4s,color .4s;
}
.hero-badge::before,.hero-badge::after{content:'';width:18px;height:1px;background:var(--gold);opacity:.5;}
.hero-mono{margin-bottom:26px;opacity:0;animation:fadeUp .8s ease .4s forwards;}
.hero-mono svg{width:108px;height:auto;}
.hero-title{
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(46px,8vw,90px);font-weight:600;color:var(--text-h);
  letter-spacing:8px;text-transform:uppercase;line-height:1;margin-bottom:5px;
  opacity:0;animation:fadeUp .8s ease .6s forwards;transition:color .4s;
}
.hero-sub{
  font-family:'Cormorant Garamond',serif;font-size:clamp(14px,2.4vw,20px);
  font-weight:300;letter-spacing:10px;text-transform:uppercase;
  color:var(--text-m);margin-bottom:34px;
  opacity:0;animation:fadeUp .8s ease .7s forwards;transition:color .4s;
}
.hero-div{
  display:flex;align-items:center;gap:18px;justify-content:center;
  margin-bottom:34px;opacity:0;animation:fadeUp .8s ease .8s forwards;
}
.hero-div-l{width:60px;height:1px;background:var(--gold);opacity:.4;transition:background .4s;}
.hero-div-d{width:8px;height:8px;background:var(--gold);transform:rotate(45deg);transition:background .4s;}
.hero-tag{
  font-size:11.5px;font-weight:300;letter-spacing:4px;text-transform:uppercase;
  color:var(--text-b);margin-bottom:50px;
  opacity:0;animation:fadeUp .8s ease .9s forwards;transition:color .4s;
}
.hero-pills{
  display:flex;gap:0;justify-content:center;flex-wrap:wrap;
  margin-bottom:56px;opacity:0;animation:fadeUp .8s ease 1s forwards;
}
.pill{
  padding:9px 20px;border:1px solid var(--border);font-size:9.5px;
  letter-spacing:2px;text-transform:uppercase;color:var(--gold);margin:4px;transition:all .3s;
}
.pill:hover{background:var(--gold-faint);border-color:var(--gold);}
.hero-btns{
  display:flex;gap:16px;justify-content:center;flex-wrap:wrap;
  opacity:0;animation:fadeUp .8s ease 1.1s forwards;
}
.btn-p{
  padding:15px 42px;background:var(--gold);color:var(--bg);
  font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;
  text-decoration:none;transition:all .3s;display:inline-block;
}
.btn-p:hover{background:var(--gold-lt);transform:translateY(-2px);box-shadow:0 12px 36px var(--shadow-btn);}
.btn-s{
  padding:14px 42px;border:1px solid var(--gold);color:var(--gold);
  font-size:10px;font-weight:600;letter-spacing:3px;text-transform:uppercase;
  text-decoration:none;transition:all .3s;display:inline-block;
}
.btn-s:hover{background:var(--gold-faint);transform:translateY(-2px);}
.hero-scroll{
  position:absolute;bottom:34px;left:50%;transform:translateX(-50%);
  display:flex;flex-direction:column;align-items:center;gap:8px;
  font-size:9px;letter-spacing:3px;text-transform:uppercase;
  color:var(--text-m);opacity:0;animation:fadeIn 1s ease 1.5s forwards;
}
.hero-scroll-l{width:1px;height:34px;background:linear-gradient(to bottom,var(--gold),transparent);animation:scrollPulse 2s ease infinite;}

/* ══ STATS ══ */
.stats{
  background:var(--bg-mid);border-top:1px solid var(--border);border-bottom:1px solid var(--border);
  padding:46px 60px;display:grid;grid-template-columns:repeat(4,1fr);
  position:relative;z-index:1;transition:background .4s;
}
.stat{
  text-align:center;padding:18px;border-right:1px solid var(--border);
  opacity:0;transform:translateY(20px);transition:opacity .6s,transform .6s;
}
.stat:last-child{border-right:none;}
.stat.vis{opacity:1;transform:translateY(0);}
.stat-n{
  font-family:'Cormorant Garamond',serif;font-size:46px;font-weight:600;
  color:var(--stat-c);line-height:1;display:block;transition:color .4s;
}
.stat-l{font-size:9.5px;letter-spacing:2.5px;text-transform:uppercase;color:var(--text-m);margin-top:8px;display:block;transition:color .4s;}

/* ══ SHARED SECTION ══ */
section{position:relative;z-index:1;}
.s-eye{font-size:9.5px;letter-spacing:4px;text-transform:uppercase;color:var(--gold);margin-bottom:13px;display:block;transition:color .4s;}
.s-ttl{
  font-family:'Cormorant Garamond',serif;font-size:clamp(32px,5vw,56px);
  font-weight:600;color:var(--text-h);line-height:1.1;letter-spacing:2px;transition:color .4s;
}
.s-ttl em{font-style:italic;color:var(--gold);transition:color .4s;}
.s-rule{display:flex;align-items:center;gap:12px;justify-content:center;margin-top:17px;}
.s-rl{width:38px;height:1px;background:var(--gold);opacity:.4;transition:background .4s;}
.s-rd{width:5px;height:5px;background:var(--gold);transform:rotate(45deg);transition:background .4s;}
.s-hdr{text-align:center;margin-bottom:62px;}

/* ══ SERVICES ══ */
.services{padding:108px 60px;background:var(--bg);transition:background .4s;}
.svc-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:2px;max-width:1100px;margin:0 auto;}
.svc-card{
  background:var(--bg-card);padding:52px 44px;position:relative;overflow:hidden;
  cursor:default;opacity:0;transform:translateY(28px);
  transition:opacity .6s,transform .6s,background .3s;
}
.svc-card.vis{opacity:1;transform:translateY(0);}
.svc-card:hover{background:var(--bg-light);}
.svc-card::before{content:'';position:absolute;top:0;left:0;width:3px;height:0;background:var(--gold);transition:height .4s;}
.svc-card:hover::before{height:100%;}
.svc-card::after{
  content:'';position:absolute;bottom:-60px;right:-60px;
  width:170px;height:170px;border-radius:50%;
  border:1px solid var(--border);transition:all .4s;
}
.svc-card:hover::after{border-color:var(--border-hov);transform:scale(1.1);}
.svc-ico{
  width:50px;height:50px;border:1px solid var(--border);
  display:flex;align-items:center;justify-content:center;
  margin-bottom:22px;color:var(--gold);transition:all .3s;
}
.svc-card:hover .svc-ico{background:var(--gold);color:var(--bg);border-color:var(--gold);}
.svc-num{
  position:absolute;top:18px;right:24px;font-family:'Cormorant Garamond',serif;
  font-size:74px;font-weight:600;color:var(--svc-n);line-height:1;pointer-events:none;
}
.svc-t{font-family:'Cormorant Garamond',serif;font-size:25px;font-weight:600;color:var(--text-h);margin-bottom:13px;letter-spacing:1px;transition:color .4s;}
.svc-d{font-size:12.5px;line-height:1.85;color:var(--text-sub);font-weight:300;transition:color .4s;}
.svc-lnk{
  display:inline-flex;align-items:center;gap:9px;margin-top:22px;
  font-size:9.5px;letter-spacing:2.5px;text-transform:uppercase;
  color:var(--gold);text-decoration:none;opacity:0;transition:opacity .3s,gap .3s;
}
.svc-card:hover .svc-lnk{opacity:1;}
.svc-lnk:hover{gap:17px;}

/* ══ ABOUT ══ */
.about{padding:108px 60px;background:var(--bg-mid);transition:background .4s;}
.about-in{max-width:1200px;margin:0 auto;display:flex;gap:68px;align-items:center;flex-wrap:wrap;}
.about-vis{flex:0 0 375px;max-width:100%;position:relative;}
.acard{
  background:var(--bg-card);border:1px solid var(--border);padding:52px;
  position:relative;z-index:1;transition:background .4s,border-color .4s;
}
.acard::before{
  content:'';position:absolute;top:-11px;left:-11px;right:11px;bottom:11px;
  border:1px solid var(--border);z-index:-1;transition:border-color .4s;
}
.acard-logo{
  width:72px;height:72px;border:2px solid var(--gold);
  display:flex;align-items:center;justify-content:center;
  font-family:'Cormorant Garamond',serif;font-size:32px;font-weight:600;
  color:var(--gold);margin-bottom:24px;transition:all .4s;
}
.acard-firm{font-family:'Cormorant Garamond',serif;font-size:21px;font-weight:600;color:var(--text-h);letter-spacing:2px;text-transform:uppercase;line-height:1.2;margin-bottom:5px;transition:color .4s;}
.acard-role{font-size:9px;letter-spacing:2.5px;text-transform:uppercase;color:var(--text-m);margin-bottom:28px;transition:color .4s;}
.arow{display:flex;align-items:flex-start;gap:11px;font-size:11.5px;color:var(--text-sub);line-height:1.55;margin-bottom:13px;transition:color .4s;}
.arow svg{flex-shrink:0;margin-top:2px;color:var(--gold);}
.about-c{flex:1;min-width:280px;}
.about-c .s-hdr{text-align:left;margin-bottom:26px;}
.about-c .s-rule{justify-content:flex-start;}
.abody{font-size:13.5px;line-height:2;color:var(--text-sub);font-weight:300;margin-bottom:17px;transition:color .4s;}
.avals{display:grid;grid-template-columns:1fr 1fr;gap:13px;margin-top:34px;}
.aval{padding:17px 21px;border:1px solid var(--border);transition:all .3s;}
.aval:hover{border-color:var(--border-hov);background:var(--gold-faint);}
.aval-l{font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--gold);margin-bottom:5px;display:block;}
.aval-d{font-size:11.5px;color:var(--text-sub);line-height:1.6;}

/* ══ WHY ══ */
.why{padding:108px 60px;background:var(--bg);transition:background .4s;}
.why-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;max-width:1100px;margin:0 auto;}
.why-item{
  padding:46px 34px;background:var(--bg-card);text-align:center;
  opacity:0;transform:translateY(20px);
  transition:opacity .6s,transform .6s,background .3s;
}
.why-item.vis{opacity:1;transform:translateY(0);}
.why-item:hover{background:var(--bg-light);}
.why-ico{
  width:46px;height:46px;border:1px solid var(--border);
  display:flex;align-items:center;justify-content:center;
  color:var(--gold);margin:0 auto 20px;transition:all .3s;
}
.why-item:hover .why-ico{background:var(--gold-faint);border-color:var(--gold);}
.why-t{font-family:'Cormorant Garamond',serif;font-size:20px;color:var(--text-h);margin-bottom:10px;font-weight:600;transition:color .4s;}
.why-d{font-size:11.5px;line-height:1.8;color:var(--text-sub);font-weight:300;transition:color .4s;}

/* ══ CONTACT ══ */
.contact{padding:108px 60px;background:var(--bg-mid);transition:background .4s;}
.contact-in{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1.2fr;gap:72px;align-items:start;}
.c-items{margin-top:34px;display:flex;flex-direction:column;gap:24px;}
.c-item{display:flex;gap:16px;align-items:flex-start;}
.c-ico{
  width:40px;height:40px;border:1px solid var(--border);
  display:flex;align-items:center;justify-content:center;
  color:var(--gold);flex-shrink:0;transition:all .3s;
}
.c-item:hover .c-ico{border-color:var(--gold);background:var(--gold-faint);}
.c-lbl{font-size:8.5px;letter-spacing:2.5px;text-transform:uppercase;color:var(--text-m);margin-bottom:4px;display:block;}
.c-val{font-size:12.5px;color:var(--text-b);line-height:1.6;font-weight:300;transition:color .4s;}
