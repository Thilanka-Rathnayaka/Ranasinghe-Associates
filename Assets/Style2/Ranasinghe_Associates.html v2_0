<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ranasinghe & Associates | Assurance, Accounting & Tax Services</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --navy: #0D1B2E;
    --navy-mid: #152238;
    --navy-light: #1E3150;
    --gold: #C9984A;
    --gold-light: #E2B96F;
    --gold-pale: #F5E6C8;
    --white: #FFFFFF;
    --off-white: #F8F4EE;
    --text-muted: rgba(201,152,74,0.6);
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--navy);
    color: var(--gold-pale);
    font-family: 'Montserrat', sans-serif;
    overflow-x: hidden;
  }

  /* ── NOISE TEXTURE OVERLAY ── */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 0;
    opacity: 0.4;
  }

  /* ── NAV ── */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 1000;
    padding: 20px 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: all 0.4s ease;
    backdrop-filter: blur(0px);
  }
  nav.scrolled {
    background: rgba(13,27,46,0.96);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(201,152,74,0.15);
    padding: 14px 60px;
    box-shadow: 0 4px 40px rgba(0,0,0,0.4);
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
  }
  .nav-logo-mark {
    width: 44px; height: 44px;
    border: 2px solid var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    font-weight: 600;
    color: var(--gold);
    letter-spacing: -1px;
  }
  .nav-logo-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: 16px;
    font-weight: 600;
    color: var(--gold);
    letter-spacing: 3px;
    text-transform: uppercase;
    line-height: 1.2;
  }
  .nav-logo-text span {
    display: block;
    font-size: 10px;
    font-family: 'Montserrat', sans-serif;
    font-weight: 400;
    letter-spacing: 4px;
    color: var(--text-muted);
  }

  .nav-links {
    display: flex;
    gap: 40px;
    list-style: none;
  }
  .nav-links a {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--gold-pale);
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 0.3s, color 0.3s;
    position: relative;
  }
  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: -4px; left: 0;
    width: 0; height: 1px;
    background: var(--gold);
    transition: width 0.3s ease;
  }
  .nav-links a:hover { opacity: 1; color: var(--gold); }
  .nav-links a:hover::after { width: 100%; }

  .nav-cta {
    padding: 10px 28px;
    border: 1px solid var(--gold);
    color: var(--gold);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .nav-cta:hover {
    background: var(--gold);
    color: var(--navy);
  }

  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    position: relative;
    padding: 100px 40px 60px;
    overflow: hidden;
  }

  /* Geometric background elements */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }
  .hero-bg-circle {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(201,152,74,0.08);
  }
  .hero-bg-circle:nth-child(1) { width: 600px; height: 600px; top: 50%; left: 50%; transform: translate(-50%,-50%); }
  .hero-bg-circle:nth-child(2) { width: 900px; height: 900px; top: 50%; left: 50%; transform: translate(-50%,-50%); }
  .hero-bg-circle:nth-child(3) { width: 1200px; height: 1200px; top: 50%; left: 50%; transform: translate(-50%,-50%); }
  .hero-bg-line {
    position: absolute;
    background: linear-gradient(90deg, transparent, rgba(201,152,74,0.12), transparent);
    height: 1px;
    width: 100%;
  }
  .hero-bg-line:nth-child(4) { top: 30%; }
  .hero-bg-line:nth-child(5) { top: 70%; }
  .hero-glow {
    position: absolute;
    width: 500px; height: 500px;
    background: radial-gradient(ellipse, rgba(201,152,74,0.07) 0%, transparent 70%);
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .hero-content { position: relative; z-index: 1; }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 20px;
    border: 1px solid rgba(201,152,74,0.3);
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 50px;
    opacity: 0;
    animation: fadeUp 0.8s ease 0.2s forwards;
  }
  .hero-badge::before, .hero-badge::after {
    content: '';
    width: 20px; height: 1px;
    background: var(--gold);
    opacity: 0.5;
  }

  /* RA Monogram SVG */
  .hero-monogram {
    margin-bottom: 30px;
    opacity: 0;
    animation: fadeUp 0.8s ease 0.4s forwards;
  }
  .hero-monogram svg { width: 120px; height: auto; }

  .hero-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(52px, 8vw, 96px);
    font-weight: 600;
    color: var(--gold-light);
    letter-spacing: 8px;
    text-transform: uppercase;
    line-height: 1;
    margin-bottom: 6px;
    opacity: 0;
    animation: fadeUp 0.8s ease 0.6s forwards;
  }
  .hero-subtitle {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(16px, 2.5vw, 22px);
    font-weight: 300;
    letter-spacing: 10px;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 40px;
    opacity: 0;
    animation: fadeUp 0.8s ease 0.7s forwards;
  }

  .hero-divider {
    display: flex;
    align-items: center;
    gap: 20px;
    justify-content: center;
    margin-bottom: 40px;
    opacity: 0;
    animation: fadeUp 0.8s ease 0.8s forwards;
  }
  .hero-divider-line { width: 60px; height: 1px; background: var(--gold); opacity: 0.4; }
  .hero-divider-diamond {
    width: 8px; height: 8px;
    background: var(--gold);
    transform: rotate(45deg);
  }

  .hero-tagline {
    font-size: 13px;
    font-weight: 300;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--gold-pale);
    opacity: 0;
    animation: fadeUp 0.8s ease 0.9s forwards;
    margin-bottom: 60px;
  }

  .hero-services-row {
    display: flex;
    gap: 0;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 70px;
    opacity: 0;
    animation: fadeUp 0.8s ease 1s forwards;
  }
  .hero-service-pill {
    padding: 10px 24px;
    border: 1px solid rgba(201,152,74,0.2);
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gold);
    margin: 4px;
    transition: all 0.3s;
  }
  .hero-service-pill:hover {
    background: rgba(201,152,74,0.1);
    border-color: var(--gold);
  }

  .hero-cta-group {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
    opacity: 0;
    animation: fadeUp 0.8s ease 1.1s forwards;
  }
  .btn-primary {
    padding: 16px 48px;
    background: var(--gold);
    color: var(--navy);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s;
    display: inline-block;
  }
  .btn-primary:hover {
    background: var(--gold-light);
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(201,152,74,0.25);
  }
  .btn-secondary {
    padding: 15px 48px;
    border: 1px solid var(--gold);
    color: var(--gold);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s;
    display: inline-block;
  }
  .btn-secondary:hover {
    background: rgba(201,152,74,0.1);
    transform: translateY(-2px);
  }

  .hero-scroll {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    font-size: 9px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--text-muted);
    opacity: 0;
    animation: fadeIn 1s ease 1.5s forwards;
  }
  .hero-scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, var(--gold), transparent);
    animation: scrollPulse 2s ease infinite;
  }

  /* ── STATS BAND ── */
  .stats-band {
    background: linear-gradient(135deg, var(--navy-mid), var(--navy-light));
    border-top: 1px solid rgba(201,152,74,0.15);
    border-bottom: 1px solid rgba(201,152,74,0.15);
    padding: 50px 60px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    position: relative;
    z-index: 1;
  }
  .stat-item {
    text-align: center;
    padding: 20px;
    border-right: 1px solid rgba(201,152,74,0.1);
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s ease;
  }
  .stat-item:last-child { border-right: none; }
  .stat-item.visible { opacity: 1; transform: translateY(0); }
  .stat-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 52px;
    font-weight: 600;
    color: var(--gold);
    line-height: 1;
    display: block;
  }
  .stat-label {
    font-size: 10px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-top: 8px;
    display: block;
  }

  /* ── SECTION SHARED ── */
  section { position: relative; z-index: 1; }

  .section-header {
    text-align: center;
    margin-bottom: 70px;
  }
  .section-eyebrow {
    font-size: 10px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 16px;
    display: block;
  }
  .section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(36px, 5vw, 60px);
    font-weight: 600;
    color: var(--gold-light);
    line-height: 1.1;
    letter-spacing: 2px;
  }
  .section-title em {
    font-style: italic;
    color: var(--gold);
  }
  .section-rule {
    display: flex;
    align-items: center;
    gap: 12px;
    justify-content: center;
    margin-top: 20px;
  }
  .section-rule-line { width: 40px; height: 1px; background: var(--gold); opacity: 0.4; }
  .section-rule-dot { width: 5px; height: 5px; background: var(--gold); transform: rotate(45deg); }

  /* ── SERVICES ── */
  .services {
    padding: 120px 60px;
    background: var(--navy);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .service-card {
    background: var(--navy-mid);
    padding: 60px 50px;
    position: relative;
    overflow: hidden;
    cursor: default;
    transition: all 0.4s ease;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease, transform 0.6s ease, background 0.3s ease;
  }
  .service-card.visible { opacity: 1; transform: translateY(0); }
  .service-card:hover { background: var(--navy-light); }

  .service-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 3px; height: 0;
    background: var(--gold);
    transition: height 0.4s ease;
  }
  .service-card:hover::before { height: 100%; }

  .service-card::after {
    content: '';
    position: absolute;
    bottom: -60px; right: -60px;
    width: 180px; height: 180px;
    border-radius: 50%;
    border: 1px solid rgba(201,152,74,0.06);
    transition: all 0.4s ease;
  }
  .service-card:hover::after {
    border-color: rgba(201,152,74,0.15);
    transform: scale(1.1);
  }

  .service-icon {
    width: 56px; height: 56px;
    border: 1px solid rgba(201,152,74,0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 28px;
    color: var(--gold);
    transition: all 0.3s;
  }
  .service-card:hover .service-icon {
    background: var(--gold);
    color: var(--navy);
    border-color: var(--gold);
  }
  .service-num {
    position: absolute;
    top: 24px; right: 30px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 80px;
    font-weight: 600;
    color: rgba(201,152,74,0.05);
    line-height: 1;
    pointer-events: none;
    transition: color 0.3s;
  }
  .service-card:hover .service-num { color: rgba(201,152,74,0.09); }

  .service-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 28px;
    font-weight: 600;
    color: var(--gold-light);
    margin-bottom: 16px;
    letter-spacing: 1px;
  }
  .service-desc {
    font-size: 13px;
    line-height: 1.85;
    color: rgba(245,230,200,0.6);
    font-weight: 300;
  }
  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    font-size: 10px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--gold);
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.3s, gap 0.3s;
  }
  .service-card:hover .service-link { opacity: 1; }
  .service-link:hover { gap: 18px; }

  /* ── ABOUT ── */
  .about {
    padding: 120px 60px;
    background: linear-gradient(135deg, var(--navy-mid) 0%, var(--navy) 100%);
    display: flex;
    gap: 80px;
    align-items: center;
    max-width: 1300px;
    margin: 0 auto;
  }
  .about-visual {
    flex: 0 0 420px;
    position: relative;
  }
  .about-card {
    background: var(--navy-light);
    border: 1px solid rgba(201,152,74,0.15);
    padding: 60px;
    position: relative;
    z-index: 1;
  }
  .about-card::before {
    content: '';
    position: absolute;
    top: -12px; left: -12px; right: 12px; bottom: 12px;
    border: 1px solid rgba(201,152,74,0.1);
    z-index: -1;
  }
  .about-card-logo {
    width: 80px; height: 80px;
    border: 2px solid var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Cormorant Garamond', serif;
    font-size: 36px;
    font-weight: 600;
    color: var(--gold);
    margin-bottom: 30px;
  }
  .about-card-firm {
    font-family: 'Cormorant Garamond', serif;
    font-size: 24px;
    font-weight: 600;
    color: var(--gold-light);
    letter-spacing: 2px;
    text-transform: uppercase;
    line-height: 1.2;
    margin-bottom: 6px;
  }
  .about-card-tagline {
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 36px;
  }
  .about-card-detail {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .about-detail-row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 12px;
    color: rgba(245,230,200,0.7);
    line-height: 1.5;
  }
  .about-detail-row svg { flex-shrink: 0; margin-top: 2px; color: var(--gold); }

  .about-content { flex: 1; }
  .about-content .section-header { text-align: left; margin-bottom: 30px; }
  .about-content .section-rule { justify-content: flex-start; }
  .about-body {
    font-size: 14px;
    line-height: 2;
    color: rgba(245,230,200,0.65);
    font-weight: 300;
    margin-bottom: 20px;
  }
  .about-values {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 40px;
  }
  .value-item {
    padding: 20px 24px;
    border: 1px solid rgba(201,152,74,0.12);
    transition: all 0.3s;
  }
  .value-item:hover {
    border-color: rgba(201,152,74,0.3);
    background: rgba(201,152,74,0.04);
  }
  .value-label {
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 6px;
    display: block;
  }
  .value-desc {
    font-size: 12px;
    color: rgba(245,230,200,0.55);
    line-height: 1.6;
  }

  /* ── WHY US ── */
  .why {
    padding: 120px 60px;
    background: var(--navy);
    text-align: center;
  }
  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    max-width: 1100px;
    margin: 0 auto;
  }
  .why-item {
    padding: 50px 40px;
    background: var(--navy-mid);
    transition: background 0.3s;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease, background 0.3s ease;
  }
  .why-item.visible { opacity: 1; transform: translateY(0); }
  .why-item:hover { background: var(--navy-light); }
  .why-icon {
    width: 50px; height: 50px;
    border: 1px solid rgba(201,152,74,0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gold);
    margin: 0 auto 24px;
    transition: all 0.3s;
  }
  .why-item:hover .why-icon {
    background: rgba(201,152,74,0.1);
    border-color: var(--gold);
  }
  .why-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    color: var(--gold-light);
    margin-bottom: 12px;
    font-weight: 600;
  }
  .why-desc {
    font-size: 12px;
    line-height: 1.8;
    color: rgba(245,230,200,0.55);
    font-weight: 300;
  }

  /* ── CONTACT ── */
  .contact {
    padding: 120px 60px;
    background: linear-gradient(135deg, var(--navy-mid), var(--navy-light));
  }
  .contact-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 80px;
    align-items: start;
  }
  .contact-info { }
  .contact-info .section-header { text-align: left; }
  .contact-info .section-rule { justify-content: flex-start; }

  .contact-items { margin-top: 40px; display: flex; flex-direction: column; gap: 30px; }
  .contact-item {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }
  .contact-icon {
    width: 44px; height: 44px;
    border: 1px solid rgba(201,152,74,0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gold);
    flex-shrink: 0;
  }
  .contact-item-label {
    font-size: 9px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 5px;
    display: block;
  }
  .contact-item-value {
    font-size: 13px;
    color: var(--gold-pale);
    line-height: 1.6;
    font-weight: 300;
  }
  .contact-item-value a {
    color: var(--gold-pale);
    text-decoration: none;
    transition: color 0.3s;
  }
  .contact-item-value a:hover { color: var(--gold); }

  /* Contact Form */
  .contact-form { }
  .form-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 28px;
    color: var(--gold-light);
    margin-bottom: 32px;
    font-weight: 500;
  }

  .form-group { margin-bottom: 20px; }
  .form-group label {
    display: block;
    font-size: 9px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 8px;
  }
  .form-group input,
  .form-group textarea,
  .form-group select {
    width: 100%;
    background: rgba(13,27,46,0.8);
    border: 1px solid rgba(201,152,74,0.2);
    padding: 14px 18px;
    color: var(--gold-pale);
